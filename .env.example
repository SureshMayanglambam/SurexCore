#--------------------------------------------------------------------
#
#     ____                               ____
#    / ___|  _   _  _ __   ___ __  __   / ___|  ___   _ __   ___
#    \___ \ | | | || '__| / _ \\ \/ /  | |     / _ \ | '__| / _ \
#     ___) || |_| || |   |  __/ >  <   | |___ | (_) || |   |  __/
#    |____/  \__,_||_|    \___|/_/\_\   \____| \___/ |_|    \___|
#
#   Lightweight CMS for shared hosting · CodeIgniter 4 + Blade
#
# SurexCore environment settings
#
# The installer copies this file to .env and fills in the values for
# each site (database, URL, a new encryption key, ...).
# To set a site up by hand: cp .env.example .env, then edit .env.
# .env holds passwords — never commit it or copy it between sites.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#   production  – live sites: errors are hidden and logged
#   development – local work: detailed errors + debug toolbar
# Switch by moving the '#'. The installer turns on development for localhost /
# *.test, and production for a real domain (never use development on a live site).
#--------------------------------------------------------------------
CI_ENVIRONMENT = development
#CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'https://example.com/'
app.appTimezone = 'Asia/Tokyo'
# true = redirect every request to HTTPS (turn on once the site has SSL)
app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# CMS
#   appName    – name of the CMS in the admin panel, and the default
#                sender name for emails
#   adminEmail – where site notifications go (contact form mail, failed-login alerts);
#                empty = failed-login alerts go to every active Administrator
# The public site name/tagline are edited in Settings → General.
#--------------------------------------------------------------------
cms.appName = 'SurexCore'
cms.adminEmail = ''
# Admin panel URL: https://example.com/{adminPath}/login
# Use your own word (letters, numbers, - and _) to hide the admin from bots; /admin then shows 404.
cms.adminPath = 'admin'
# Failed logins for one login ID (from any IP): email the admins after loginAlertAfter,
# lock that login ID for loginLockMinutes after loginLockAfter. 0 = off.
# cms.loginAlertAfter = 3
# cms.loginLockAfter = 10
# cms.loginLockMinutes = 15
# Block an IP from the admin panel after this many failed logins, until it is unblocked in
# Settings → Security (or its line is deleted from writable/security/blocked-ips.txt). 0 = off.
# cms.ipBlockAfter = 3
# Images uploaded in the admin are saved as WebP (JPEG lossy at webpQuality, PNG lossless),
# when that makes them smaller. false = keep JPEG/PNG.
# cms.convertToWebp = true
# cms.webpQuality = 82

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = 'localhost'
database.default.database = ''
database.default.username = ''
database.default.password = ''
database.default.DBDriver = MySQLi
database.default.DBPrefix = 'sc_'
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#   A random secret, unique to each site. The installer generates it;
#   by hand: php spark key:generate
#   Don't copy it to another site, and don't change it once a site is
#   live if you store encrypted data with encrypt()/decrypt().
#--------------------------------------------------------------------
encryption.key =

#--------------------------------------------------------------------
# EMAIL (SMTP)
#   Use the SMTP details from your hosting control panel or mail
#   service. Typical: port 587 + tls, or port 465 + ssl.
#   Test it in the admin panel: Settings → General → Send test email.
#--------------------------------------------------------------------
email.protocol = 'smtp'
email.fromEmail = ''
email.fromName = ''
email.SMTPHost = ''
email.SMTPUser = ''
email.SMTPPass = ''
email.SMTPPort = 587
email.SMTPCrypto = 'tls'
email.mailType = 'html'
